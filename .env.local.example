# Hosted Postgres connection string (must have the `vector` extension enabled).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Voyage AI — used for embeddings (Anthropic has no embeddings API).
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Google Drive service account. Create the service account and key yourself
# in Google Cloud Console, then share the target Drive folder with the
# service account's email address (found in the key JSON as "client_email").
# Paste the *entire* key JSON contents as a single-line string here.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Anthropic API key — powers the deal-workspace chat agent (lib/agent.ts).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
